# Google Gemini API Key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for the discovery conversation (default shown below)
GEMINI_MODEL=gemini-3.6-flash

# Gemini native-audio model for the coach's voice. Uses GEMINI_API_KEY above.
# Falls back to Google Cloud TTS (Chirp 3 HD Puck) if unavailable.
GEMINI_TTS_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_VOICE=Puck

# App environment
NEXT_PUBLIC_APP_ENV=development
