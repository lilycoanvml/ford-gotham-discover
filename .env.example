# Google Gemini API Key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for the discovery conversation (default shown below)
GEMINI_MODEL=gemini-3.6-flash

# Short reaction turns only. A lite model with no thinking budget answers in
# ~500ms vs ~5s, which is most of the per-turn wait the user feels.
GEMINI_REACTION_MODEL=gemini-3.5-flash-lite

# Audio-to-audio model for the conversation itself. The browser streams mic PCM
# to /api/live, this model hears it and answers in its own voice — no
# speech-to-text in front of it and no text synthesis behind it.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Same model, used as a plain reader for the fixed lines whose wording is
# guaranteed (the opening line and the three questions). Falls back to Google
# Cloud TTS (Chirp 3 HD Charon) if unavailable.
GEMINI_TTS_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_VOICE=Charon

# App environment
NEXT_PUBLIC_APP_ENV=development
